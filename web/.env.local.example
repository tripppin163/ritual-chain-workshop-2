# Copy to web/.env.local

# Deployed RitualPredict address (printed by hardhat/scripts/deploy.ts, or by
# hardhat/scripts/local-demo.ts when running against a local node).
NEXT_PUBLIC_PREDICT_ADDRESS=0x

# 1979 = Ritual Chain testnet, 31337 = a local `npx hardhat node`.
NEXT_PUBLIC_CHAIN_ID=1979
NEXT_PUBLIC_RPC_URL=https://rpc.ritualfoundation.org

# The oracle URL suggested by the create form. A TEE executor in the cloud fetches
# this, so localhost will never resolve — expose /api/oracle/eth through a tunnel and
# put that URL here.
NEXT_PUBLIC_DEMO_ORACLE_URL=https://your-tunnel.example/api/oracle/eth

# Optional: upstream the demo oracle reads. Defaults to Coinbase's public spot price.
ORACLE_UPSTREAM_URL=https://api.coinbase.com/v2/prices/ETH-USD/spot
